# Copy this file to .env and fill in your own values from
# your Supabase project: Project Settings -> API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Name of the Supabase Storage bucket used for cover/detail/draft images.
# Create this bucket (public read) in your Supabase project before running the app.
VITE_SUPABASE_STORAGE_BUCKET=sirajan-munira-media
